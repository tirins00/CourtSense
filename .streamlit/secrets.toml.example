# Copy this file to .streamlit/secrets.toml and paste your real key(s).
# secrets.toml is git-ignored. Never commit it.

# Primary LLM provider (OpenAI-compatible Aiki Labs endpoint)
OPENAI_API_KEY = "your-openai-api-key-here"
OPENAI_BASE_URL = "https://aiki-labs.up.railway.app/api/v1"

# Optional fallback LLM provider (Groq)
# GROQ_API_KEY = "your-groq-api-key-here"

# Optional: free API-Sports key for live volleyball league standings/results.
# Register at https://dashboard.api-sports.io (free plan, 100 requests/day).
# Without it, volleyball falls back to explanations and your uploaded data.
# API_SPORTS_KEY = "your-api-sports-key-here"

# Optional: daily prompt limit per browser (defaults to 20). Resets at local midnight.
# PROMPT_DAILY_LIMIT = 20
